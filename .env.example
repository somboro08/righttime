# Identifiants publics de l'entreprise Rightcom pour l'application de démonstration.
EXPO_PUBLIC_RIGHTTIME_PUBLIC_KEY=pk_votre_cle_publique
EXPO_PUBLIC_RIGHTTIME_COMPANY=votre-identifiant-entreprise

# Android Emulator : 10.0.2.2. Simulateur iOS : 127.0.0.1.
# Téléphone physique : adresse IP locale du PC sur le même réseau Wi-Fi.
EXPO_PUBLIC_RIGHTTIME_API_URL=http://10.0.2.2:8000/api
EXPO_PUBLIC_RIGHTTIME_HOST_ORIGIN=https://www.mon-site-autorise.com

# Bundle web utilisé pour afficher le widget RightTime dans la WebView.
EXPO_PUBLIC_RIGHTTIME_SDK_CDN_URL=https://cdn.rightcom.com/righttime/v1/righttime.global.js

# URL de la page de réservation hébergée, pour la démo WebView distante.
EXPO_PUBLIC_RIGHTTIME_WIDGET_URL=https://www.mon-site-autorise.com/booking
